# Server Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated for local Next.js frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=sb_publishable_...
# REQUIRED for Server-Side Database Writes & RLS Bypass:
# Find in: Supabase Dashboard -> Project Settings -> API -> service_role secret key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
